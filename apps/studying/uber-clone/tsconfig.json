{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["vite/client", "node"],
    "jsx": "react-jsx"
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "services/**/*.ts",
    "services/**/*.tsx",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "infra/cdk"]
}
