{
  "name": "@studying/uber-clone",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n ride,matching,location,web -c cyan,green,yellow,magenta \"tsx watch --clear-screen=false services/ride-service/src/index.ts\" \"tsx watch --clear-screen=false services/ride-matching-service/src/index.ts\" \"tsx watch --clear-screen=false services/location-service/src/index.ts\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:setup": "tsx scripts/db-setup.ts",
    "bootstrap": "tsx scripts/bootstrap-sfn-local.ts",
    "seed": "tsx scripts/seed-drivers.ts",
    "cdk:synth": "cd infra/cdk && npx cdk synth",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sfn": "^3.800.0",
    "@everythingme/ui": "workspace:*",
    "@hono/node-server": "^1.13.8",
    "@hono/zod-validator": "^0.4.3",
    "@xyflow/react": "^12.8.2",
    "concurrently": "^9.1.2",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.7.10",
    "ioredis": "^5.6.1",
    "leaflet": "^1.9.4",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "aws-cdk-lib": "^2.200.0",
    "constructs": "^10.4.2",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vite": "^8.0.0"
  }
}
